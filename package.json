{
  "name": "stroymarket-checks",
  "version": "1.0.0",
  "private": true,
  "description": "Инструменты проверки учебного проекта, не зависимости интерфейса",
  "scripts": {
    "check:html": "html-validate 'frontend/*.html'",
    "check:js": "node --check frontend/app.js",
    "format:check": "prettier --check frontend"
  },
  "devDependencies": {
    "axe-core": "4.10.3",
    "html-validate": "11.21.0",
    "prettier": "3.5.3"
  }
}
